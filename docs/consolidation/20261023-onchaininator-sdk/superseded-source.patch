+  managedControlAndObjectTransactionCount: transactions.length - carrierTransactions.length,
+  carrierGas,
+  managedControlAndObjectGas,
+  publicationGas,
+  publicationFeeWei,
+  totalEip7623FloorGas: totalFloorGas,
+  minimumTransactionGasHeadroom: minimumHeadroom,
