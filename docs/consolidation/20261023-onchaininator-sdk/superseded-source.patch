+} from "../packages/sdk/dist/index.js";
+import { ABIS as graphAbis } from "../packages/sdk/dist/abis/keel-graph.generated.js";
+
+const expectedFunctions = [
+  "MAX_COMMUNITY_ACTIVE_TAGS",
+  "MAX_LABEL_BYTES",
+  "MAX_TAG_BATCH",
+  "bitIndex",
+  "canonicalTagWord",
+  "canonicalWord",
+  "communityCount",
+  "communityTagCount",
