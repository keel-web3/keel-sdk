diff --git a/tests/helpers/marketplace-csp-browser.mjs b/tests/helpers/marketplace-csp-browser.mjs
new file mode 100644
index 0000000..a091c1c
--- /dev/null
+++ b/tests/helpers/marketplace-csp-browser.mjs
@@ -0,0 +1,95 @@
+// Real event-bound browser observation: the 4,000ms deadline is unchanged.
+import {spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+async function launch(binary) {
+  const profile = await mkdtemp(join(tmpdir(), "keel-audio-chrome-"));
+  const child = spawn(binary, [
+    "--headless",
+    "--mute-audio",
+    "--autoplay-policy=document-user-activation-required",
+    "--remote-debugging-port=0",
+    `--user-data-dir=${profile}`,
+    "about:blank",
+  ], { stdio: ["ignore", "ignore", "pipe"] });
+  let stderr = "";
+  child.stderr.setEncoding("utf8");
+  const endpoint = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`Chrome did not expose DevTools: ${stderr}`)), 15_000);
+    child.stderr.on("data", (chunk) => {
+      stderr += chunk;
+      const match = /DevTools listening on (ws:\/\/\S+)/u.exec(stderr);
+      if (match) { clearTimeout(timer); resolve(match[1]); }
+    });
+    child.on("error", reject);
+  });
+  const socket = new WebSocket(endpoint);
+  await new Promise((resolve, reject) => { socket.onopen = resolve; socket.onerror = reject; });
+  let nextId = 0;
+  const pending = new Map();
+  const listeners = [];
+  socket.onmessage = ({ data }) => {
+    const message = JSON.parse(data);
+    if (message.id !== undefined) {
+      const entry = pending.get(message.id);
+      pending.delete(message.id);
+      if (message.error) entry.reject(new Error(`${entry.method}: ${message.error.message}`));
+      else entry.resolve(message.result);
+    } else for (const listener of listeners) listener(message);
+  };
+  const send = (method, params = {}, sessionId = undefined) => new Promise((resolve, reject) => {
+    const id = ++nextId;
+    pending.set(id, { resolve, reject, method });
+    socket.send(JSON.stringify({ id, method, params, ...(sessionId === undefined ? {} : { sessionId }) }));
+  });
+  return {
+    send,
+    on: (listener) => listeners.push(listener),
+    close: async () => {
+      socket.close();
+      child.kill("SIGKILL");
+      await once(child, "exit").catch(() => {});
+      await rm(profile, { recursive: true, force: true });
+    },
+  };
+}
+
+
+export async function observeMarketplaceCsp(binary,url,protocol) {
+  const browser=await launch(binary),events=[],requests=[],contexts=new Map();
+  browser.on(({method,params,sessionId})=>{
+    if(method==='Target.attachedToTarget') {
+      const child=params.sessionId;
+      void Promise.all([browser.send('Runtime.enable',{},child),browser.send('Log.enable',{},child),browser.send('Network.enable',{},child),browser.send('Target.setAutoAttach',{autoAttach:true,waitForDebuggerOnStart:false,flatten:true},child)]).catch(error=>events.push({kind:'instrumentation',text:String(error)}));
+    }
+    if(method==='Runtime.executionContextCreated')contexts.set(`${sessionId}:${params.context.id}`,{sessionId,contextId:params.context.id});
+    if(method==='Runtime.executionContextDestroyed')contexts.delete(`${sessionId}:${params.executionContextId}`);
+    if(method==='Runtime.exceptionThrown')events.push({kind:'exception',text:params.exceptionDetails.exception?.description??params.exceptionDetails.text});
+    if(method==='Log.entryAdded')events.push({kind:params.entry.source,level:params.entry.level,text:params.entry.text});
+    if(method==='Network.requestWillBeSent')requests.push(params.request.url);
+  });
+  try {
+    const {targetId}=await browser.send('Target.createTarget',{url:'about:blank'});
+    const {sessionId}=await browser.send('Target.attachToTarget',{targetId,flatten:true});
+    await Promise.all([browser.send('Runtime.enable',{},sessionId),browser.send('Log.enable',{},sessionId),browser.send('Page.enable',{},sessionId),browser.send('Network.enable',{},sessionId),browser.send('Target.setAutoAttach',{autoAttach:true,waitForDebuggerOnStart:false,flatten:true},sessionId)]);
+    const deadline=Date.now()+4000;
+    await browser.send('Page.navigate',{url},sessionId);
+    let state;
+    // Completion is the actual artwork message, never a fixed virtual-time dump.
+    do {
+      const result=await browser.send('Runtime.evaluate',{expression:'JSON.stringify({state:document.querySelector("#result")?.dataset.state,text:document.querySelector("#result")?.textContent,protocol:document.querySelector("#result")?.dataset.protocol})',returnByValue:true},sessionId);
+      if(typeof result.result?.value==='string')state=JSON.parse(result.result.value);
+      if(state?.state==='passed'||state?.state==='failed')break;
+      await new Promise(resolve=>setTimeout(resolve,10));
+    } while(Date.now()<deadline);
+    const snapshot=await browser.send('Runtime.evaluate',{expression:'document.documentElement.outerHTML',returnByValue:true},sessionId);
+    const frames=[];
+    for(const context of contexts.values()) {
+      try {const result=await browser.send('Runtime.evaluate',{expression:'JSON.stringify({origin:location.origin,html:document.documentElement.tagName,sandbox:frameElement?.getAttribute("sandbox")??null,image:(()=>{const image=document.querySelector("#keel-asset-display img");return image?{complete:image.complete,width:image.naturalWidth,height:image.naturalHeight}:null})()})',contextId:context.contextId,returnByValue:true},context.sessionId);if(typeof result.result?.value==='string')frames.push(JSON.parse(result.result.value));}catch{}
+    }
+    const stderr=events.filter(event=>event.kind==='exception'||event.kind==='security').map(event=>event.text).join('\n');
+    return {stdout:snapshot.result.value,stderr,events,requests,frames,state,protocol};
+  } finally {await browser.close();}
+}
