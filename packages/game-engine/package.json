{
  "name": "@keel/game-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The KEEL pixel-art game engine, carried by the SDK: its parts, standard packs and AI, the authoring API (defineEntity, defineAttribute, definePack...), and the build that turns a project into KEEL modules and a KEEL document.",
  "bin": {
    "keel-game": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./*": "./src/engine/*.ts"
  },
  "scripts": {
    "link": "node scripts/link-engine.mjs"
  },
  "dependencies": {
    "@keel-engine/audio": "link:../../../keel-engine/packages/audio",
    "@keel-engine/bake": "link:../../../keel-engine/packages/bake",
    "@keel-engine/builder": "link:../../../keel-engine/packages/builder",
    "@keel-engine/camera": "link:../../../keel-engine/packages/camera",
    "@keel-engine/capture": "link:../../../keel-engine/packages/capture",
    "@keel-engine/codec": "link:../../../keel-engine/packages/codec",
    "@keel-engine/core": "link:../../../keel-engine/packages/core",
    "@keel-engine/entity": "link:../../../keel-engine/packages/entity",
    "@keel-engine/import": "link:../../../keel-engine/packages/import",
    "@keel-engine/input": "link:../../../keel-engine/packages/input",
    "@keel-engine/keel": "link:../../../keel-engine/packages/keel",
    "@keel-engine/level": "link:../../../keel-engine/packages/level",
    "@keel-engine/object": "link:../../../keel-engine/packages/object",
    "@keel-engine/particles": "link:../../../keel-engine/packages/particles",
    "@keel-engine/physics": "link:../../../keel-engine/packages/physics",
    "@keel-engine/render": "link:../../../keel-engine/packages/render",
    "@keel-engine/runtime": "link:../../../keel-engine/packages/runtime",
    "@keel-engine/scene": "link:../../../keel-engine/packages/scene",
    "@keel-engine/terrain": "link:../../../keel-engine/packages/terrain",
    "@keel-engine/ui": "link:../../../keel-engine/packages/ui",
    "@keel-engine/view": "link:../../../keel-engine/packages/view",
    "@keel-engine/world": "link:../../../keel-engine/packages/world",
    "@keel-engine/worldgen": "link:../../../keel-engine/packages/worldgen",
    "@keel-engine/animals": "link:../../../keel-engine/packs/animals",
    "@keel-engine/buildings": "link:../../../keel-engine/packs/buildings",
    "@keel-engine/cloth": "link:../../../keel-engine/packs/cloth",
    "@keel-engine/creatures": "link:../../../keel-engine/packs/creatures",
    "@keel-engine/dungeon": "link:../../../keel-engine/packs/dungeon",
    "@keel-engine/foliage": "link:../../../keel-engine/packs/foliage",
    "@keel-engine/humans": "link:../../../keel-engine/packs/humans",
    "@keel-engine/herd": "link:../../../keel-engine/ai/herd",
    "@keel-engine/wander": "link:../../../keel-engine/ai/wander"
  }
}
