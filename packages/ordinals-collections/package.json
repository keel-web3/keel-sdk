{
  "name": "@keel/ordinals-collections",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KOC1 v1 specification and deterministic conformance vectors",
  "scripts": {
    "vectors:generate": "node spec/vectors/generate.mjs",
    "vectors:check": "node spec/vectors/check.mjs",
    "test": "node --test test/*.test.mjs && node spec/vectors/check.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tx": "./src/tx.ts",
    "./envelope": "./src/envelope.ts",
    "./mint": "./src/mint.ts",
    "./escrow": "./src/escrow.ts",
    "./end": "./src/end.ts",
    "./controls": "./src/controls.ts",
    "./merkle": "./src/merkle.ts",
    "./perm": "./src/perm.ts",
    "./index-root": "./src/index/root.mjs",
    "./merge": "./src/merge/index.mjs",
    "./challenge": "./src/challenge/index.mjs",
    "./sources": "./indexer/sources.mjs",
    "./block-loop": "./indexer/loop.mjs",
    "./discovery": "./indexer/discovery.mjs",
    "./cache": "./indexer/cache.mjs",
    "./verify-token": "./src/verify/token.mjs",
    "./shell": "./src/shell/index.mjs"
  },
  "bin": {
    "keel-ordinals": "./bin/keel-ordinals.mjs"
  }
}
