{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@keel/sdk/module"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".keel/*.d.ts"
  ]
}
