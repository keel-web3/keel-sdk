pragma solidity ^0.8.20;

interface ITemplateHold { function slugPointer(bytes32 id) external view returns(address); }

/// Local proof candidate: shared binary resources are encoded only while reading.
/// Recipes must be prepared and verified through the SDK before publication.
contract KeelBinaryTemplateReader {
    bytes private constant PAIRS=hex"";
    struct Input { bytes32[] slugs; bool base64; }
    struct Source { address[] pointers; uint256 length; bool base64; }
    struct Recipe { uint16[] sequence; uint256 length; bytes32 digest; bool exists; }
    ITemplateHold public immutable hold;
    address public immutable owner;
    Source[] private sources;
    mapping(uint256 => Recipe) private recipes;
    error Invalid();
    constructor(address h) { if(h.code.length==0)revert Invalid();hold=ITemplateHold(h);owner=msg.sender; }
    function addSources(Input[] calldata inputs) external {
        if(msg.sender!=owner)revert Invalid();
        for(uint256 i;i<inputs.length;i++){
            if(inputs[i].slugs.length==0 || sources.length>=65535)revert Invalid();
            Source storage s=sources.push();s.base64=inputs[i].base64;
            for(uint256 j;j<inputs[i].slugs.length;j++){
                address p=hold.slugPointer(inputs[i].slugs[j]);uint256 n=p.code.length;
                if(n<=1)revert Invalid();s.pointers.push(p);s.length+=n-1;
            }
        }
    }
    function setRecipe(uint256 id,uint16[] calldata sequence,uint256 length,bytes32 digest) external {
        if(msg.sender!=owner || recipes[id].exists || sequence.length==0 || digest==bytes32(0))revert Invalid();
        uint256 measured;
        for(uint256 i;i<sequence.length;i++){
            if(sequence[i]>=sources.length)revert Invalid();Source storage s=sources[sequence[i]];
            measured+=s.base64?4*((s.length+2)/3):s.length;
        }
        if(measured!=length)revert Invalid();recipes[id]=Recipe(sequence,length,digest,true);
    }
    function tokenURI(uint256 id) external view returns(string memory){_returnRecipe(id*4+1);return "";}
    function tokenJSON(uint256 id) external view returns(string memory){_returnRecipe(id*4);return "";}
    function image(uint256 id) external view returns(string memory){_returnRecipe(id*4+2);return "";}
    function animation(uint256 id) external view returns(string memory){_returnRecipe(id*4+3);return "";}
    function resolveMode() external pure returns(bytes32){return "manual";}
    fallback(bytes calldata input) external returns(bytes memory){
        if(input.length<17 || keccak256(input[:11])!=keccak256("/tokenJSON/") || keccak256(input[input.length-5:])!=keccak256(".json"))revert Invalid();
        uint256 id;uint256 end=input.length-5;
        if(end-11>10 || (end-11>1 && input[11]=="0"))revert Invalid();
        for(uint256 i=11;i<end;i++){uint8 c=uint8(input[i]);if(c<48||c>57)revert Invalid();id=id*10+c-48;}
        _returnRecipe(id*4);return "";
    }
    function _returnRecipe(uint256 id) private view {
        Recipe storage r=recipes[id];if(!r.exists)revert Invalid();
        // Reserve the ABI offset before the string. Return directly, avoiding
        // an additional whole-document memory allocation during ABI encoding.
        bytes memory envelope=new bytes(r.length+64);bytes memory out;
        assembly("memory-safe"){out:=add(envelope,32)}
        uint256 n=r.length;assembly("memory-safe"){mstore(out,n)}
        uint256[] memory prior=new uint256[](sources.length);
        uint256 cursor;
        bytes memory pairs=PAIRS;
        for(uint256 i;i<r.sequence.length;i++){
            uint256 key=r.sequence[i];Source storage s=sources[key];
            uint256 count=s.base64?4*((s.length+2)/3):s.length;
            if(prior[key]!=0){_copy(out,prior[key]-1,cursor,count);}
            else {
                prior[key]=cursor+1;
                if(s.base64){
                    bytes memory raw=new bytes(s.length);uint256 offset;
                    for(uint256 j;j<s.pointers.length;j++){address p=s.pointers[j];uint256 size=p.code.length-1;assembly("memory-safe"){extcodecopy(p,add(add(raw,32),offset),1,size)}offset+=size;}
                    _encode(raw,out,cursor,pairs);
                }else{
                    uint256 offset=cursor;
                    for(uint256 j;j<s.pointers.length;j++){address p=s.pointers[j];uint256 size=p.code.length-1;assembly("memory-safe"){extcodecopy(p,add(add(out,32),offset),1,size)}offset+=size;}
                }
            }
            cursor+=count;
        }
        if(cursor!=r.length || sha256(out)!=r.digest)revert Invalid();
        assembly("memory-safe"){mstore(add(add(out,32),n),0)}
        assembly("memory-safe"){mstore(envelope,32) return(envelope,add(64,and(add(n,31),not(31))))}
    }
    function _copy(bytes memory out,uint256 from,uint256 to,uint256 n) private pure {
        assembly("memory-safe"){
            let src:=add(add(out,32),from) let dst:=add(add(out,32),to)
            // Repeated resources do not overlap. Only copy full words and the
            // exact tail so bytes after a source cannot corrupt a later part.
            let words:=and(n,not(31))
            for{let i:=0}lt(i,words){i:=add(i,32)}{mstore(add(dst,i),mload(add(src,i)))}
            for{let i:=words}lt(i,n){i:=add(i,1)}{mstore8(add(dst,i),byte(0,mload(add(src,i))))}
        }
    }
    function _encode(bytes memory raw,bytes memory out,uint256 offset,bytes memory pairs) private pure {
        assembly("memory-safe"){
            let table:=add(pairs,32) let src:=add(raw,32) let end:=add(src,mload(raw)) let dst:=add(add(out,32),offset)
            let mask:=shl(240,65535)
            for{}lt(src,end){src:=add(src,3) dst:=add(dst,4)}{
                let v:=shr(232,mload(src))
                switch sub(end,src) case 1{v:=and(v,0xff0000)}case 2{v:=and(v,0xffff00)}
                let high:=and(mload(add(table,shl(1,shr(12,v)))),mask)
                let low:=shr(16,and(mload(add(table,shl(1,and(v,4095)))),mask))
                // The final output allocation reserves a 32-byte guard. Later
                // parts overwrite speculative zero bytes beyond this quartet.
                mstore(dst,or(high,low))
            }
            switch mod(mload(raw),3) case 1{mstore8(sub(dst,2),61)mstore8(sub(dst,1),61)}case 2{mstore8(sub(dst,1),61)}
        }
    }
}
